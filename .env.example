# Local development values for the compose database. Copy to .env.

# Owner role: runs migrations.
LEDGERLINE_MIGRATE_URL=postgres://ledgerline:ledgerline@localhost:5433/ledgerline?sslmode=disable

# Application role: serve and worker connect as this.
LEDGERLINE_DATABASE_URL=postgres://ledgerline_app:ledgerline_app@localhost:5433/ledgerline?sslmode=disable

# A superuser connection the tests use to create a throwaway database per test.
LEDGERLINE_TEST_DATABASE_URL=postgres://ledgerline:ledgerline@localhost:5433/ledgerline?sslmode=disable

LEDGERLINE_ADDR=:8080
